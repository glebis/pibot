# --- Transport ---
# "telegram" or "cli" (default: telegram if TELEGRAM_BOT_TOKEN is set, else cli)
PIBOT_TRANSPORT=telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather

# Comma-separated chat IDs allowed to talk to the bot (empty = deny all — pairing mode).
# When denied, the bot replies with your chat id. Add it here and restart.
TELEGRAM_ALLOWED_CHATS=
# Set to 1 to allow any Telegram user that discovers the bot (opt-in, not recommended)
# PIBOT_TELEGRAM_OPEN=1

# --- Cloud providers ---
# API keys come from the environment here (or from the encrypted settings env
# map for the daemon). Subscription sign-ins — Claude Pro/Max, SuperGrok / X
# Premium, etc — are managed in the dashboard → Providers and stored in the
# shared ~/.pi/agent/auth.json, exactly like `pi auth login`.

# --- Optional avatar image providers ---
# Local deterministic avatar generation needs no configuration. Remote avatar
# generation happens only when an avatar-enabled agent explicitly invokes that
# provider; discovery/status checks make no request. Keep real values outside Git.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations
# NANO_BANANA_API_KEY=
# NANO_BANANA_IMAGE_MODEL=nano-banana
# NANO_BANANA_IMAGE_ENDPOINT=https://your-openai-compatible-endpoint.example/v1/images/generations

# --- Paths ---
# Runtime personas, memory, skills, and sessions are private by default.
# Override only when you intentionally want a different private data root.
# PIBOT_AGENTS_DIR=~/.local/share/pibot/agents
PIBOT_DATA_DIR=./data

# --- Agents ---
# Agent to use for new chats by default
PIBOT_DEFAULT_AGENT=assistant
# Fallback cheap model for heartbeat ticks (per-agent override in agent.json)
# e.g. "anthropic/claude-haiku-4-5" or "same"
PIBOT_HEARTBEAT_MODEL=same
# Default model for wizard-created agents (no per-agent model set)
PIBOT_DEFAULT_MODEL=ollama/glm-5.3-flash:cloud
# Global fallback candidates. Each agent must allow their providers in agent.json.
PIBOT_MODEL_CASCADE=ollama/minimax-m3:cloud

# --- Developer agent (off by default) ---
# Set to 1 to scaffold the built-in pibot-dev agent: it develops, tests, and
# stages the pibot source itself. React-only (no heartbeat/self-initiation).
# It works in a workspace at the repo root; changes land as git checkpoint
# commits and ONLY after typecheck + tests pass (dev_stage refuses otherwise).
# PIBOT_DEV_AGENT=1
# Override its model (defaults to PIBOT_DEFAULT_MODEL)
# PIBOT_DEV_MODEL=anthropic/claude-sonnet-4-5

# --- Dashboard auth (Touch ID / WebAuthn + Bearer) ---
# Required to bootstrap the first passkey; also supports authenticated curl requests.
PIBOT_WEB_TOKEN=
# Relying Party ID for WebAuthn (must match the hostname you open the dashboard on).
# Defaults to 127.0.0.1 (works for http://127.0.0.1:7860). Use "localhost" if you prefer http://localhost:7860.
PIBOT_WEB_RP_ID=127.0.0.1
# Alias for backwards-compat
# PIBOT_WEB_AUTH=127.0.0.1
PIBOT_WEB_PORT=7860
