{
  "name": "pibot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal agent companion built on the pi SDK — chat with agents that have independent plugin systems, memory, and a scheduling heartbeat.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "cli": "PIBOT_TRANSPORT=cli tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "evolve": "tsx scripts/evolve.ts",
    "test:telegram": "tsx scripts/telegram-live-test.mts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@hono/node-server": "^2.1.1",
    "@simplewebauthn/server": "^13.3.3",
    "grammy": "^1.46.0",
    "hono": "^4.13.5",
    "jpeg-js": "^0.4.4",
    "typebox": "^1.3.20"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Gleb Kalinin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glebis/pibot.git"
  }
}
